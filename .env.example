# =====================================================================
# PERSONAL TRACKER — ENVIRONMENT CONFIGURATION (.env)
# =====================================================================

# 1. Supabase Project URL
# Copy from: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public API Key
# Copy from: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: If these variables are left empty or omitted, Personal Tracker
# will automatically run in local standalone mode using IndexedDB/LocalStorage!
